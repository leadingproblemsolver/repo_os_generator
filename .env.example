# Objective: Declare explicit local runtime configuration keys.
# Why it exists: Operators should not guess environment variable names.
# How to use: Copy to .env only when a local shell or process manager reads it.
# Dependencies: src/support_agent/config.py.
# Owner: Builder.
# Update policy: Keep this aligned with Settings in src/support_agent/config.py.
# Examples: SUPPORT_AGENT_ENV=local.
# Related files: OPERABILITY.md, infra/README.md.

SUPPORT_AGENT_ENV=local
SUPPORT_AGENT_LOG_LEVEL=INFO
SUPPORT_DEFAULT_PRIORITY=normal
